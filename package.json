{
  "name": "presign-guard",
  "version": "2.0.0",
  "description": "Pre-sign risk check for AI agents: green/orange/red verdicts for EVM transactions, approvals and Permit/Permit2/Seaport signatures, paid per call via x402",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "test": "node --test test/*.test.mjs",
    "client": "node --env-file-if-exists=.env scripts/agent-client.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/kit": "^5.5.1",
    "@x402/avm": "^2.28.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/express": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/mcp": "^2.27.0",
    "@x402/stellar": "^2.28.0",
    "@x402/svm": "^2.27.0",
    "@x402/xrpl": "^2.28.0",
    "algosdk": "^3.8.0",
    "express": "^5.2.1",
    "mppx": "^0.13.4",
    "redis": "^5.12.1",
    "ripple-binary-codec": "^2.11.0",
    "viem": "^2.56.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@x402/fetch": "^2.27.0"
  },
  "overrides": {
    "@stellar/stellar-sdk": {
      "axios": "^1.20.0"
    }
  }
}
