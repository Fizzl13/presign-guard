# Wallet that receives the payments: 0x followed by 40 hex characters, no spaces.
PAY_TO=0xYourPayoutAddress

# eip155:84532 = Base Sepolia (test money), eip155:8453 = Base mainnet
X402_NETWORK=eip155:84532

# Mainnet only: Coinbase CDP facilitator (also lists the service in the CDP Bazaar).
# Set these in the Render dashboard, never commit them.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Needed for /v1/check/explain
ANTHROPIC_API_KEY=

# Optional
GOPLUS_ACCESS_TOKEN=
PUBLIC_URL=https://presign-guard.onrender.com

# Only for `npm run client` (end-to-end test): a throwaway wallet with test USDC
AGENT_PRIVATE_KEY=
CHECK_URL=http://localhost:3000
